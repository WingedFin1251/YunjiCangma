{
  "app": {
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ],
    // ⚠️ 不要提交签名配置：DevEco 真机调试会自动往这里写入本机证书路径与口令（属本机私有信息）。
    //    本仓库历史上曾误把该段提交进公开历史，2026-10-11 已清空；
    //    本地需要签名时由 IDE 重新写入（会出现在 git diff 里，提交前请确认本段为 []）。
    "signingConfigs": []
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
